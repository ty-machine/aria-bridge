<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aria.bridge.poller</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!-- EDIT: full path to where you put poll_aria.sh -->
        <string>/Users/YOUR_USERNAME/aria_bridge/poll_aria.sh</string>
    </array>

    <!-- run every 5 minutes -->
    <key>StartInterval</key>
    <integer>300</integer>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/aria_bridge_poller.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/aria_bridge_poller.log</string>
</dict>
</plist>

<!--
Install:
    cp com.aria.bridge.poller.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.aria.bridge.poller.plist

Check it's running:
    launchctl list | grep aria.bridge

Uninstall:
    launchctl unload ~/Library/LaunchAgents/com.aria.bridge.poller.plist
    rm ~/Library/LaunchAgents/com.aria.bridge.poller.plist

Watch logs:
    tail -f /tmp/aria_bridge_poller.log
-->
