# Copy this file to mise.local.toml (already gitignored, mise loads it
# automatically alongside mise.toml) and fill in your actual values.
#
#   cp mise.local.toml.example mise.local.toml
#   mise trust
#
# mac/redeploy.sh and ubuntu/redeploy.sh read these instead of hardcoding
# your network's real host/user in a committed file.

[env]
ARIA_MAC_SSH_HOST = "10.0.0.10"
ARIA_MAC_SSH_USER = "yourusername"
ARIA_UBUNTU_SSH_HOST = "10.0.0.11"
ARIA_UBUNTU_SSH_USER = "yourusername"